generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model AppCredential {
  id              String            @id
  platform        String
  label           String
  clientId        String?
  clientSecret    String?
  serviceId       String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  PlatformAccount PlatformAccount[]

  @@unique([platform, label])
}

model BundleItem {
  id                 String         @id
  bundleProductId    String
  componentVariantId String
  qty                Int
  createdAt          DateTime       @default(now())
  MasterProduct      MasterProduct  @relation(fields: [bundleProductId], references: [id], onDelete: Cascade)
  ProductVariant     ProductVariant @relation(fields: [componentVariantId], references: [id])

  @@unique([bundleProductId, componentVariantId])
  @@index([componentVariantId])
}

model Business {
  id              String            @id
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  MasterProduct   MasterProduct[]
  PlatformAccount PlatformAccount[]
  UserBusiness    UserBusiness[]
}

model InventorySetting {
  id                       String   @id @default("inventory-default")
  lowStockDefaultThreshold Int      @default(20)
  notifyLowStock           Boolean  @default(true)
  notifyLowStockEmail      Boolean  @default(false)
  syncPushTokopedia        Boolean  @default(true)
  syncPushShopee           Boolean  @default(true)
  syncPushTiktok           Boolean  @default(true)
  opnameReminderFrequency  String   @default("monthly")
  updatedAt                DateTime
}

model MasterProduct {
  id             String           @id
  name           String
  category       String?
  imageUrl       String?
  type           String           @default("single")
  status         String           @default("active")
  isActive       Boolean          @default(true)
  importedFrom   String?
  businessId     String           @default("business-default")
  threshold      Int              @default(20)
  BundleItem     BundleItem[]
  Business       Business         @relation(fields: [businessId], references: [id])
  ProductImage   ProductImage[]
  ProductVariant ProductVariant[]
}

model Order {
  id                      String                 @id
  orderNo                 String
  status                  String
  buyerName               String?
  buyerEmail              String?
  amount                  Float?
  currency                String?
  createTime              DateTime?
  paidTime                DateTime?
  shippingDueTime         DateTime?
  rtsSlaTime              DateTime?
  ttsSlaTime              DateTime?
  recommendedShippingTime DateTime?
  buyerNote               String?
  sellerNote              String?
  isCod                   Boolean?
  paymentMethodName       String?
  paymentJson             String?
  recipientName           String?
  recipientPhone          String?
  recipientAddress        String?
  piiAnonymizedAt         DateTime?
  accountId               String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime
  PlatformAccount         PlatformAccount        @relation(fields: [accountId], references: [id])
  OrderItem               OrderItem[]
  PlatformOrderMapping    PlatformOrderMapping[]
  ReturnRequest           ReturnRequest[]
  Shipment                Shipment[]

  @@index([accountId, createTime])
  @@index([createTime, status])
}

model OrderItem {
  id             String          @id
  qty            Int
  price          Float?
  channelSku     String
  productId      String?
  imageUrl       String?
  productName    String?
  skuName        String?
  orderId        String
  variantId      String?
  Order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId, channelSku])
}

model PiiAccessLog {
  id        String   @id
  userId    String
  username  String
  orderId   String?
  orderNo   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}

model PlatformAccount {
  id                   String                 @id
  businessId           String                 @default("business-default")
  platform             String
  label                String
  appKey               String?
  accessToken          String?
  refreshToken         String?
  tokenExpiresAt       DateTime?
  scope                String?
  externalShopId       String?
  shopCipher           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  appCredentialId      String?
  frozenReason         String?
  isFrozen             Boolean                @default(false)
  Order                Order[]
  AppCredential        AppCredential?         @relation(fields: [appCredentialId], references: [id])
  Business             Business               @relation(fields: [businessId], references: [id])
  PlatformOrderMapping PlatformOrderMapping[]
  ProductMapping       ProductMapping[]
  PromotionActivity    PromotionActivity[]
  PromotionAuditLog    PromotionAuditLog[]
  ReturnAuditLog       ReturnAuditLog[]
  ReturnRequest        ReturnRequest[]
  SalesLog             SalesLog[]
  Shipment             Shipment[]
  StockLedger          StockLedger[]
  SyncJob              SyncJob[]
  SyncLog              SyncLog[]

  @@unique([platform, externalShopId])
}

model PlatformOrderMapping {
  id                    String          @id
  externalOrderId       String
  rawStatus             String
  lastWebhookUpdateTime Int?
  orderId               String
  accountId             String
  PlatformAccount       PlatformAccount @relation(fields: [accountId], references: [id])
  Order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalOrderId])
}

model ProductImage {
  id              String        @id
  masterProductId String
  url             String
  isCover         Boolean       @default(false)
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  MasterProduct   MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
}

model ProductMapping {
  id                    String                  @id
  channelSku            String
  variantId             String                  @default("")
  accountId             String
  price                 Float?
  priceUpdatedAt        DateTime?
  platformProductId     String?
  platformStatus        String?
  platformStatusRaw     String?
  platformStock         Int?
  platformTitle         String?
  lastSyncedAt          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  PlatformAccount       PlatformAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ProductVariant        ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  PromotionActivityItem PromotionActivityItem[]
  PromotionAuditLog     PromotionAuditLog[]

  @@unique([accountId, channelSku])
  @@unique([accountId, variantId])
}

model ProductVariant {
  id              String            @id
  sku             String
  stock           Int
  name            String?
  safetyStock     Int               @default(0)
  minStock        Int?
  notifyEmail     Boolean           @default(false)
  price           Float?
  priceUpdatedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  masterProductId String
  BundleItem      BundleItem[]
  OrderItem       OrderItem[]
  ProductMapping  ProductMapping[]
  MasterProduct   MasterProduct     @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  ReturnItem      ReturnItem[]
  SalesLog        SalesLog[]
  StockLedger     StockLedger[]
  StockOpnameItem StockOpnameItem[]
  SyncJob         SyncJob[]

  @@unique([masterProductId, sku])
}

model PromotionActivity {
  id                    String                  @id
  accountId             String
  externalActivityId    String
  title                 String
  activityType          String
  status                String
  productLevel          String
  durationType          String?
  startsAt              DateTime
  endsAt                DateTime
  sourceCreatedAt       DateTime?
  sourceUpdatedAt       DateTime?
  sourceCreatedEpoch    String?
  sourceCreatedUnit     String?
  sourceUpdatedEpoch    String?
  sourceUpdatedUnit     String?
  lastConfirmedAt       DateTime?
  rawPayload            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  PlatformAccount       PlatformAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  PromotionActivityItem PromotionActivityItem[]

  @@unique([accountId, externalActivityId])
  @@index([accountId, startsAt])
  @@index([accountId, status])
}

model PromotionActivityItem {
  id                    String            @id
  activityId            String
  externalItemKey       String
  platformProductId     String
  platformSkuId         String?
  productMappingId      String?
  discount              String?
  activityPriceAmount   String?
  activityPriceCurrency String?
  quantityLimit         Int?
  quantityPerUser       Int?
  usedQuantity          Int?
  rawPayload            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime
  PromotionActivity     PromotionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ProductMapping        ProductMapping?   @relation(fields: [productMappingId], references: [id])

  @@unique([activityId, externalItemKey])
  @@index([platformProductId])
  @@index([platformSkuId])
  @@index([productMappingId])
}

model PromotionAuditLog {
  id                 String          @id
  accountId          String
  userId             String
  username           String
  action             String
  externalActivityId String?
  activityTitle      String?
  payloadSent        String?
  resultStatus       String
  tiktokCode         Int?
  tiktokMessage      String?
  requestId          String?
  itemsBefore        String?
  itemsAfter         String?
  batchIndex         Int?
  batchTotal         Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime
  productMappingId   String?
  PlatformAccount    PlatformAccount @relation(fields: [accountId], references: [id])
  ProductMapping     ProductMapping? @relation(fields: [productMappingId], references: [id])

  @@index([accountId, createdAt])
  @@index([externalActivityId])
  @@index([resultStatus])
  @@index([userId, createdAt])
}

model ReturnAuditLog {
  id               String          @id
  accountId        String
  returnId         String?
  externalReturnId String?
  userId           String
  username         String
  action           String
  payloadSent      String?
  resultStatus     String
  platformError    String?
  platformMessage  String?
  requestId        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  PlatformAccount  PlatformAccount @relation(fields: [accountId], references: [id])
  ReturnRequest    ReturnRequest?  @relation(fields: [returnId], references: [id])

  @@index([accountId, createdAt])
  @@index([resultStatus])
  @@index([returnId])
}

model ReturnItem {
  id              String          @id
  returnId        String
  externalSkuId   String?
  channelSku      String
  productName     String?
  skuName         String?
  imageUrl        String?
  qty             Int
  price           Float?
  variantId       String?
  restockedAt     DateTime?
  restockLedgerId String?
  ReturnRequest   ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  ProductVariant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([returnId, channelSku])
  @@index([variantId])
}

model ReturnRequest {
  id                     String           @id
  accountId              String
  externalReturnId       String
  externalOrderId        String?
  orderId                String?
  status                 String
  rawStatus              String
  rawPayload             String?
  type                   String?
  requestType            String?
  reason                 String?
  reasonText             String?
  solution               String?
  refundAmount           Float?
  currency               String?
  buyerEvidence          String?
  negotiation            String?
  isPlatformAutoApproved Boolean          @default(false)
  slaDueDate             DateTime?
  firstSeenAt            DateTime         @default(now())
  lastSyncedAt           DateTime?
  statusChangedAt        DateTime?
  ReturnAuditLog         ReturnAuditLog[]
  ReturnItem             ReturnItem[]
  PlatformAccount        PlatformAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Order                  Order?           @relation(fields: [orderId], references: [id])

  @@unique([accountId, externalReturnId])
  @@index([accountId, status])
  @@index([slaDueDate])
}

model SalesLog {
  id              String          @id
  time            DateTime        @default(now())
  qty             Int
  stockAfter      Int
  critical        Boolean
  text            String
  channelSku      String
  variantId       String          @default("")
  accountId       String
  PlatformAccount PlatformAccount @relation(fields: [accountId], references: [id])
  ProductVariant  ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([variantId, time])
}

model Shipment {
  id                    String                  @id
  externalId            String?
  carrier               String?
  trackingNo            String?
  status                String
  shippedAt             DateTime?
  orderId               String
  accountId             String
  PlatformAccount       PlatformAccount         @relation(fields: [accountId], references: [id])
  Order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ShipmentTrackingEvent ShipmentTrackingEvent[]

  @@unique([accountId, orderId, externalId])
}

model ShipmentTrackingEvent {
  id          String   @id
  shipmentId  String
  actionCode  Int?
  description String
  eventTime   DateTime
  createdAt   DateTime @default(now())
  Shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, eventTime, description])
  @@index([shipmentId, eventTime])
}

model StockLedger {
  id              String           @id
  changeQty       Int
  reason          String
  referenceId     String?
  note            String?
  stockAfter      Int
  variantId       String
  accountId       String?
  userId          String?
  createdAt       DateTime         @default(now())
  PlatformAccount PlatformAccount? @relation(fields: [accountId], references: [id])
  User            User?            @relation(fields: [userId], references: [id])
  ProductVariant  ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([reason, referenceId, variantId])
  @@index([reason, referenceId])
  @@index([variantId, createdAt])
}

model StockOpname {
  id              String            @id
  code            String            @unique
  status          String
  note            String?
  startedAt       DateTime          @default(now())
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  userId          String?
  User            User?             @relation(fields: [userId], references: [id])
  StockOpnameItem StockOpnameItem[]

  @@index([status, startedAt])
}

model StockOpnameItem {
  id             String         @id
  opnameId       String
  variantId      String
  systemStock    Int
  countedStock   Int?
  StockOpname    StockOpname    @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  ProductVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([opnameId, variantId])
  @@index([variantId])
}

model SyncJob {
  id              String          @id
  channelSku      String
  newSellable     Int
  status          String          @default("PENDING")
  retryCount      Int             @default(0)
  nextRetryAt     DateTime?
  lastError       String?
  accountId       String
  variantId       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  PlatformAccount PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ProductVariant  ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, accountId, channelSku, status])
  @@index([status, nextRetryAt])
  @@index([variantId])
}

model SyncLog {
  id              String          @id
  direction       String
  kind            String
  status          String
  message         String?
  errorMessage    String?
  payload         String?
  accountId       String
  handledAt       DateTime?
  handledBy       String?
  createdAt       DateTime        @default(now())
  PlatformAccount PlatformAccount @relation(fields: [accountId], references: [id])
}

model User {
  id             String         @id
  username       String         @unique
  passwordHash   String
  canViewFullPii Boolean        @default(true)
  StockLedger    StockLedger[]
  StockOpname    StockOpname[]
  UserBusiness   UserBusiness[]
}

model UserBusiness {
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
}
