# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# database (SQLite local)
*.db
*.db-journal
prisma/backup-*/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e (playwright, toolchain di luar project)
e2e/screenshots/
e2e/test-results/

# test output & artefak sementara (jangan di-commit)
test-results/
scripts/tmp-*.mts
scripts/tmp-*.mjs
docs/*-results.json
